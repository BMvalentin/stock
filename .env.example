# Variables de entorno de ejemplo. Copiar a `.env` y completar los valores.
# Nunca commitear `.env` ni credenciales reales.

# Conexión a PostgreSQL (base de datos remota o local).
DATABASE_URL="postgresql://usuario:contrasena@host:5432/basededatos?schema=public"

# Secreto de Auth.js. Generar con: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (opcional). Si no se define, el login con Google no se muestra.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Datos del administrador inicial usados por `prisma db seed` (opcional).
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="cambiar-esta-clave"
