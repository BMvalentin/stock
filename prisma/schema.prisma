// Esquema de datos del sistema de gestión de stock, productos y pedidos.
// Convenciones: modelos Prisma en PascalCase (requerido por Prisma),
// valores de enums en MAYÚSCULAS con guion bajo. Resto del código en español.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// Autenticación (Auth.js / NextAuth)
// ============================================================

enum Rol {
  ADMIN
  EMPLEADO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  rol           Rol       @default(EMPLEADO)
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  movimientos      MovimientoStock[]
  pedidos          Pedido[]
  pagos            Pago[]
  auditorias       Auditoria[]
  historialPrecios PrecioProductoHistorial[]
  empleado         Empleado?
  tokensFichaje    TokenFichajeQR[]

  @@index([rol])
  @@index([activo])
  // Listado de empleados: filtra por estado/rol y ordena por nombre.
  @@index([activo, rol, name])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Catálogo
// ============================================================

// Modalidad de venta del producto. Define cómo se interpreta el precio de
// `PrecioProducto`: por unidad o por kilogramo. Es una propiedad del producto,
// no del pedido: el operador no puede cambiarla al vender.
enum UnidadVenta {
  UNIDAD
  KILOGRAMO
}

model Categoria {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productos Producto[]

  @@index([activo])
  // Listado de categorías: orden por estado y nombre.
  @@index([activo, nombre])
}

model Producto {
  id               String   @id @default(cuid())
  nombre           String
  descripcion      String?
  // SKU opcional. En MySQL/TiDB un índice único admite múltiples NULL, por lo
  // que varios productos pueden no tener SKU sin bloquearse entre sí, pero los
  // SKU ingresados siguen siendo únicos.
  sku              String?  @unique
  // Código de barras comercial (EAN/UPC/Code 128). Independiente del SKU.
  // Opcional: no todos los productos tienen código. En MySQL un índice único
  // admite múltiples NULL, por lo que no bloquea productos sin barcode.
  barcode          String?  @unique
  categoriaId      String
  // Modalidad de venta: interpreta el precio y la unidad del stock.
  unidadVenta      UnidadVenta @default(UNIDAD)
  // Decimal para admitir productos vendidos por peso (ej. 95.500 kg).
  stockActual      Decimal  @default(0) @db.Decimal(12, 3)
  stockMinimo      Decimal  @default(0) @db.Decimal(12, 3)
  // 1 producto = 1 bulto en la v1. Se mantiene el campo para evolucionar.
  unidadesPorBulto Int      @default(1)
  // Imagen de referencia en Cloudinary. `imagePublicId` permite reemplazar o
  // eliminar el recurso; la imagen es opcional.
  imageUrl         String?
  imagePublicId    String?
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categoria        Categoria                 @relation(fields: [categoriaId], references: [id])
  precios          PrecioProducto[]
  historialPrecios PrecioProductoHistorial[]
  movimientos      MovimientoStock[]
  proveedores      ProductoProveedor[]
  detalles         DetallePedido[]
  tarifasEmpleado  EmpleadoTarifaProducto[]
  producciones     EmpleadoProduccion[]

  @@index([categoriaId])
  @@index([nombre])
  @@index([stockActual])
  @@index([activo])
}

// ============================================================
// Precios y métodos de pago
// ============================================================

model MetodoPago {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nombre    String
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  precios                  PrecioProducto[]
  pedidos                  Pedido[]
  pagos                    Pago[]
  precioProductoHistorials PrecioProductoHistorial[]

  @@index([activo])
}

model PrecioProducto {
  id           String   @id @default(cuid())
  productoId   String
  metodoPagoId String
  precio       Decimal  @db.Decimal(12, 2)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  producto   Producto   @relation(fields: [productoId], references: [id])
  metodoPago MetodoPago @relation(fields: [metodoPagoId], references: [id])

  @@unique([productoId, metodoPagoId])
  @@index([metodoPagoId])
}

model PrecioProductoHistorial {
  id             String   @id @default(cuid())
  productoId     String
  metodoPagoId   String
  precioAnterior Decimal? @db.Decimal(12, 2)
  precioNuevo    Decimal  @db.Decimal(12, 2)
  usuarioId      String
  createdAt      DateTime @default(now())

  producto   Producto   @relation(fields: [productoId], references: [id])
  metodoPago MetodoPago @relation(fields: [metodoPagoId], references: [id])
  usuario    User       @relation(fields: [usuarioId], references: [id])

  @@index([productoId, createdAt])
  @@index([usuarioId])
}

// ============================================================
// Proveedores
// ============================================================

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  empresa   String?
  // CUIT/CUIL del proveedor, normalizado a 11 dígitos. Opcional.
  cuit      String?
  telefono  String?
  whatsapp  String?
  email     String?
  direccion String?
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productos   ProductoProveedor[]
  cuentasPago CuentaPagoProveedor[]

  @@index([nombre])
  @@index([activo])
  // Listado de proveedores: orden por estado y nombre.
  @@index([activo, nombre])
}

// Medio de pago con el que se utilizará una cuenta del proveedor. Es un enum
// propio y no reutiliza la tabla `MetodoPago` (esa representa los métodos de
// cobro al cliente usados en precios y pedidos).
enum MetodoPagoProveedor {
  TRANSFERENCIA_BANCARIA
  TRANSFERENCIA_CVU
  MERCADO_PAGO
  EFECTIVO
  OTRO
}

enum TipoCuentaProveedor {
  CAJA_AHORRO
  CUENTA_CORRIENTE
  CUENTA_VIRTUAL
  OTRA
}

// Datos/cuentas de pago de un proveedor. Un proveedor puede tener varias.
// `esPrincipal` es único entre las cuentas activas (se garantiza en el
// servicio con transacción). `activo = false` es la baja lógica: la cuenta se
// conserva en el historial y puede reactivarse.
model CuentaPagoProveedor {
  id          String               @id @default(cuid())
  proveedorId String
  // Identificador de pago: al menos uno de alias/cbu/cvu, salvo EFECTIVO.
  alias       String?
  cbu         String?
  cvu         String?
  titular     String?
  titularCuit String?
  banco       String?
  tipoCuenta  TipoCuentaProveedor?
  metodoPago  MetodoPagoProveedor
  esPrincipal Boolean              @default(false)
  activo      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)

  @@index([proveedorId])
  @@index([proveedorId, activo])
  @@index([proveedorId, esPrincipal])
}

model ProductoProveedor {
  id              String   @id @default(cuid())
  productoId      String
  proveedorId     String
  esPrincipal     Boolean  @default(false)
  codigoProveedor String?
  costo           Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  producto  Producto  @relation(fields: [productoId], references: [id])
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([productoId, proveedorId])
  @@index([proveedorId])
  @@index([productoId, esPrincipal])
}

// ============================================================
// Stock
// ============================================================

enum TipoMovimiento {
  INGRESO
  EGRESO
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  VENTA
  DEVOLUCION
}

model MovimientoStock {
  id             String         @id @default(cuid())
  productoId     String
  tipo           TipoMovimiento
  cantidad       Decimal        @db.Decimal(12, 3)
  stockAnterior  Decimal        @db.Decimal(12, 3)
  stockPosterior Decimal        @db.Decimal(12, 3)
  usuarioId      String
  motivo         String?
  pedidoId       String?
  createdAt      DateTime       @default(now())

  producto Producto @relation(fields: [productoId], references: [id])
  usuario  User     @relation(fields: [usuarioId], references: [id])
  pedido   Pedido?  @relation(fields: [pedidoId], references: [id])

  @@index([productoId, createdAt])
  @@index([createdAt])
  @@index([tipo])
  @@index([usuarioId])
  @@index([pedidoId])
  // Listado de movimientos: filtra por tipo/usuario y ordena por fecha.
  @@index([tipo, createdAt])
  @@index([usuarioId, createdAt])
}

// ============================================================
// Pedidos
// ============================================================

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  LISTO
  ENTREGADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  AVISADO
  CONFIRMADO
  RECHAZADO
}

enum TipoEntrega {
  RETIRO
  ENVIO_DOMICILIO
}

model Pedido {
  id               String       @id @default(cuid())
  numero           Int          @unique @default(autoincrement())
  // Datos del comprador congelados al momento del pedido (no dependen de una
  // entidad Cliente). El sistema no tiene gestión independiente de clientes.
  clienteNombre    String
  clienteTelefono  String
  clienteDireccion String?
  clienteLocalidad String?
  usuarioId        String
  estado           EstadoPedido @default(PENDIENTE)
  estadoPago       EstadoPago   @default(PENDIENTE)
  metodoPagoId     String?
  tipoEntrega      TipoEntrega  @default(RETIRO)
  direccionEntrega String?
  // Snapshot de la entrega al momento del pedido. `mapsUrl` permite abrir la
  // ubicación exacta que cargó el operador; latitud/longitud son opcionales y
  // no reemplazan a la URL. `referencia` es una ayuda para el repartidor.
  referenciaEntrega String?
  mapsUrl          String?
  latitud          Decimal?     @db.Decimal(10, 7)
  longitud         Decimal?     @db.Decimal(10, 7)
  subtotal         Decimal      @db.Decimal(12, 2)
  costoEnvio       Decimal      @default(0) @db.Decimal(12, 2)
  total            Decimal      @db.Decimal(12, 2)
  observaciones    String?
  // Banderas de idempotencia para no descontar ni devolver stock dos veces.
  stockDescontado  Boolean      @default(false)
  stockDevuelto    Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  usuario     User              @relation(fields: [usuarioId], references: [id])
  metodoPago  MetodoPago?       @relation(fields: [metodoPagoId], references: [id])
  detalles    DetallePedido[]
  pagos       Pago[]
  movimientos MovimientoStock[]

  @@index([estado])
  @@index([estadoPago])
  @@index([createdAt])
  @@index([usuarioId])
  // Listado de pedidos: filtra por estado/pago y ordena por fecha.
  @@index([estado, createdAt])
  @@index([estadoPago, createdAt])
}

model DetallePedido {
  id             String  @id @default(cuid())
  pedidoId       String
  productoId     String
  // Datos congelados al momento de la venta (no depender del producto actual).
  nombreProducto String
  // Modalidad de venta congelada: el histórico no cambia si el producto cambia.
  unidadVenta    UnidadVenta
  precioUnitario Decimal @db.Decimal(12, 2)
  cantidad       Decimal @db.Decimal(12, 3)
  subtotal       Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
  @@index([productoId])
}

model Pago {
  id           String     @id @default(cuid())
  pedidoId     String
  metodoPagoId String?
  monto        Decimal    @db.Decimal(12, 2)
  estado       EstadoPago @default(PENDIENTE)
  usuarioId    String
  observacion  String?
  createdAt    DateTime   @default(now())

  pedido     Pedido      @relation(fields: [pedidoId], references: [id])
  metodoPago MetodoPago? @relation(fields: [metodoPagoId], references: [id])
  usuario    User        @relation(fields: [usuarioId], references: [id])

  @@index([pedidoId])
  @@index([estado])
}

// ============================================================
// Configuración general del comercio
// ============================================================

model ConfiguracionGeneral {
  id             String   @id @default(cuid())
  nombreComercio String
  moneda         String   @default("ARS")
  locale         String   @default("es-AR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================
// Configuración de envío
// ============================================================

enum TipoCalculoEnvio {
  SIN_CARGO
  TARIFA_FIJA
  POR_PRODUCTO
  POR_BULTO
}

model ConfiguracionEnvio {
  id        String           @id @default(cuid())
  tipo      TipoCalculoEnvio
  precio    Decimal          @default(0) @db.Decimal(12, 2)
  activo    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([activo])
}

// ============================================================
// Auditoría
// ============================================================

model Auditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  accion    String
  entidad   String
  entidadId String?
  datos     Json?
  resultado String?
  createdAt DateTime @default(now())

  usuario User? @relation(fields: [usuarioId], references: [id])

  @@index([createdAt])
  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([accion])
  // Listado de auditoría: filtra y ordena por fecha descendente.
  @@index([usuarioId, createdAt])
  @@index([accion, createdAt])
  @@index([entidad, createdAt])
}

// ============================================================
// Remuneración de empleados
// ============================================================

// Modalidad de remuneración. Es excluyente: un empleado se paga por hora o por
// producción, nunca por ambas. Si en el futuro se necesita combinar, debe
// modelarse explícitamente.
enum TipoRemuneracion {
  POR_HORA
  POR_PRODUCCION
}

// Estado de la jornada registrada. La ausencia no genera pago de jornada.
enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}

// Origen del registro de asistencia. `QR` identifica el fichaje automático
// desde el teléfono; `MANUAL_ADMIN` la carga o corrección de un administrador.
enum OrigenAsistencia {
  QR
  MANUAL_ADMIN
}

// Estados de la liquidación. ABIERTA permite correcciones; CALCULADA congela
// los valores; PAGADA y CANCELADA son terminales.
enum EstadoLiquidacion {
  ABIERTA
  CALCULADA
  PAGADA
  CANCELADA
}

// Perfil laboral asociado 1:1 a un User. No duplica el sistema de usuarios:
// la baja lógica sigue siendo `User.activo`. Separa los datos de remuneración
// (sensibles) de la tabla de autenticación.
model Empleado {
  id                  String           @id @default(cuid())
  userId              String           @unique
  tipoRemuneracion    TipoRemuneracion @default(POR_HORA)
  // Configuración de jornada para la modalidad POR_HORA. El tramo 1 usa
  // `horaEntradaEsperada`/`horaSalidaEsperada`. El tramo 2 es opcional: se deja
  // en null para la jornada continua y se completa en la jornada partida.
  horasJornada               Decimal  @default(8) @db.Decimal(5, 2)
  pagoJornada                Decimal  @default(0) @db.Decimal(12, 2)
  horaEntradaEsperada        String   @default("08:00")
  horaSalidaEsperada         String   @default("16:00")
  horaEntradaTramo2Esperada  String?
  horaSalidaTramo2Esperada   String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asistencias   EmpleadoAsistencia[]
  producciones  EmpleadoProduccion[]
  tarifas       EmpleadoTarifaProducto[]
  liquidaciones EmpleadoLiquidacion[]

  @@index([tipoRemuneracion])
}

// Jornada registrada de un empleado por hora. `fecha` es date-only y las horas
// son texto "HH:mm": el cálculo de minutos no depende de la zona horaria del
// servidor. Soporta jornada continua (solo tramo 1) o partida (tramo 1 y 2):
// `horaEntrada`/`horaSalida` son el tramo 1 y `horaEntradaTramo2`/
// `horaSalidaTramo2` el tramo 2. `minutosTrabajados` y `minutosRetraso` son los
// totales del día y se congelan al calcular; los retrasos por tramo se guardan
// para conservarlos en el histórico.
model EmpleadoAsistencia {
  id                    String            @id @default(cuid())
  empleadoId            String
  fecha                 DateTime          @db.Date
  horaEntrada           String?
  horaSalida            String?
  horaEntradaTramo2     String?
  horaSalidaTramo2      String?
  minutosTrabajados     Int?
  minutosRetraso        Int?
  minutosRetrasoTramo1  Int?
  minutosRetrasoTramo2  Int?
  estado                EstadoAsistencia  @default(PRESENTE)
  origen                OrigenAsistencia  @default(MANUAL_ADMIN)
  // Instante del último fichaje. Se usa para evitar duplicar un doble escaneo
  // accidental en una ventana corta de tiempo.
  ultimoFichajeEn       DateTime?
  observacion           String?
  liquidacionId         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  empleado    Empleado             @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  liquidacion EmpleadoLiquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)

  @@unique([empleadoId, fecha])
  @@index([empleadoId, fecha])
  @@index([liquidacionId])
  @@index([ultimoFichajeEn])
}

// Tarifa que se paga a un empleado por unidad producida de un producto. Es
// independiente del precio de venta (`PrecioProducto`). Una fila por
// empleado+producto; la baja es lógica (`activo = false`) para conservar el
// historial y permitir reactivar.
model EmpleadoTarifaProducto {
  id           String   @id @default(cuid())
  empleadoId   String
  productoId   String
  precioUnidad Decimal  @db.Decimal(12, 2)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([empleadoId, productoId])
  @@index([empleadoId, productoId])
  @@index([productoId])
}

// Producción registrada de un empleado por producción. Guarda snapshot del
// precio unitario y del total: cambiar la tarifa no altera registros pasados.
// No modifica el stock del producto.
model EmpleadoProduccion {
  id            String   @id @default(cuid())
  empleadoId    String
  productoId    String
  fecha         DateTime @db.Date
  cantidad      Int
  precioUnidad  Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  liquidacionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  empleado    Empleado             @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  producto    Producto             @relation(fields: [productoId], references: [id])
  liquidacion EmpleadoLiquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)

  @@index([empleadoId, fecha])
  @@index([productoId])
  @@index([liquidacionId])
}

// Liquidación de un período. Al calcularse se congela el total y el detalle
// (JSON) y se vinculan las asistencias/producciones incluidas para evitar
// doble pago. Una liquidación cerrada nunca se recalcula.
model EmpleadoLiquidacion {
  id               String            @id @default(cuid())
  empleadoId       String
  desde            DateTime          @db.Date
  hasta            DateTime          @db.Date
  tipoRemuneracion TipoRemuneracion
  total            Decimal           @db.Decimal(12, 2)
  estado           EstadoLiquidacion @default(ABIERTA)
  detalle          Json?
  calculadaEn      DateTime?
  pagadaEn         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  empleado     Empleado              @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  asistencias  EmpleadoAsistencia[]
  producciones EmpleadoProduccion[]

  @@unique([empleadoId, desde, hasta])
  @@index([empleadoId, desde])
  @@index([estado])
  // Historial de liquidaciones de un empleado filtrado por estado.
  @@index([empleadoId, estado])
}

// Token temporal que habilita el fichaje por QR. La pantalla del comercio lo
// genera y renueva; el teléfono lo escanea y el servidor lo valida. Nunca se
// guarda el token en claro: solo su hash. Es compartido por todos los empleados
// mientras esté vigente; la identidad surge de la sesión autenticada.
model TokenFichajeQR {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  expiraEn    DateTime
  creadoPorId String?
  createdAt   DateTime @default(now())

  creadoPor User? @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([expiraEn])
  @@index([creadoPorId])
}
