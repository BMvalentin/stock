// Esquema de datos del sistema de gestión de stock, productos y pedidos.
// Convenciones: modelos Prisma en PascalCase (requerido por Prisma),
// valores de enums en MAYÚSCULAS con guion bajo. Resto del código en español.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Autenticación (Auth.js / NextAuth)
// ============================================================

enum Rol {
  ADMIN
  EMPLEADO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  rol           Rol       @default(EMPLEADO)
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  movimientos      MovimientoStock[]
  pedidos          Pedido[]
  pagos            Pago[]
  auditorias       Auditoria[]
  historialPrecios PrecioProductoHistorial[]

  @@index([rol])
  @@index([activo])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Catálogo
// ============================================================

model Categoria {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productos Producto[]

  @@index([activo])
}

model Producto {
  id               String   @id @default(cuid())
  nombre           String
  descripcion      String?
  sku              String   @unique
  categoriaId      String
  stockActual      Int      @default(0)
  stockMinimo      Int      @default(0)
  // 1 producto = 1 bulto en la v1. Se mantiene el campo para evolucionar.
  unidadesPorBulto Int      @default(1)
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categoria        Categoria                 @relation(fields: [categoriaId], references: [id])
  precios          PrecioProducto[]
  historialPrecios PrecioProductoHistorial[]
  movimientos      MovimientoStock[]
  proveedores      ProductoProveedor[]
  detalles         DetallePedido[]

  @@index([categoriaId])
  @@index([nombre])
  @@index([stockActual])
  @@index([activo])
}

// ============================================================
// Precios y métodos de pago
// ============================================================

model MetodoPago {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nombre    String
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  precios                  PrecioProducto[]
  pedidos                  Pedido[]
  pagos                    Pago[]
  precioProductoHistorials PrecioProductoHistorial[]

  @@index([activo])
}

model PrecioProducto {
  id           String   @id @default(cuid())
  productoId   String
  metodoPagoId String
  precio       Decimal  @db.Decimal(12, 2)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  producto   Producto   @relation(fields: [productoId], references: [id])
  metodoPago MetodoPago @relation(fields: [metodoPagoId], references: [id])

  @@unique([productoId, metodoPagoId])
  @@index([metodoPagoId])
}

model PrecioProductoHistorial {
  id             String   @id @default(cuid())
  productoId     String
  metodoPagoId   String
  precioAnterior Decimal? @db.Decimal(12, 2)
  precioNuevo    Decimal  @db.Decimal(12, 2)
  usuarioId      String
  createdAt      DateTime @default(now())

  producto   Producto   @relation(fields: [productoId], references: [id])
  metodoPago MetodoPago @relation(fields: [metodoPagoId], references: [id])
  usuario    User       @relation(fields: [usuarioId], references: [id])

  @@index([productoId, createdAt])
  @@index([usuarioId])
}

// ============================================================
// Proveedores
// ============================================================

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  empresa   String?
  telefono  String?
  whatsapp  String?
  email     String?
  direccion String?
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productos ProductoProveedor[]

  @@index([nombre])
  @@index([activo])
}

model ProductoProveedor {
  id              String   @id @default(cuid())
  productoId      String
  proveedorId     String
  esPrincipal     Boolean  @default(false)
  codigoProveedor String?
  costo           Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  producto  Producto  @relation(fields: [productoId], references: [id])
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([productoId, proveedorId])
  @@index([proveedorId])
  @@index([productoId, esPrincipal])
}

// ============================================================
// Stock
// ============================================================

enum TipoMovimiento {
  INGRESO
  EGRESO
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  VENTA
  DEVOLUCION
}

model MovimientoStock {
  id             String         @id @default(cuid())
  productoId     String
  tipo           TipoMovimiento
  cantidad       Int
  stockAnterior  Int
  stockPosterior Int
  usuarioId      String
  motivo         String?
  pedidoId       String?
  createdAt      DateTime       @default(now())

  producto Producto @relation(fields: [productoId], references: [id])
  usuario  User     @relation(fields: [usuarioId], references: [id])
  pedido   Pedido?  @relation(fields: [pedidoId], references: [id])

  @@index([productoId, createdAt])
  @@index([createdAt])
  @@index([tipo])
  @@index([usuarioId])
  @@index([pedidoId])
}

// ============================================================
// Clientes y pedidos
// ============================================================

model Cliente {
  id            String   @id @default(cuid())
  nombre        String
  telefono      String
  email         String?
  direccion     String?
  localidad     String?
  codigoPostal  String?
  observaciones String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pedidos Pedido[]

  @@index([telefono])
  @@index([nombre])
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  LISTO
  ENTREGADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  AVISADO
  CONFIRMADO
  RECHAZADO
}

enum TipoEntrega {
  RETIRO
  ENVIO_DOMICILIO
}

model Pedido {
  id               String       @id @default(cuid())
  numero           Int          @unique @default(autoincrement())
  clienteId        String
  usuarioId        String
  estado           EstadoPedido @default(PENDIENTE)
  estadoPago       EstadoPago   @default(PENDIENTE)
  metodoPagoId     String?
  tipoEntrega      TipoEntrega  @default(RETIRO)
  direccionEntrega String?
  subtotal         Decimal      @db.Decimal(12, 2)
  costoEnvio       Decimal      @default(0) @db.Decimal(12, 2)
  total            Decimal      @db.Decimal(12, 2)
  observaciones    String?
  // Banderas de idempotencia para no descontar ni devolver stock dos veces.
  stockDescontado  Boolean      @default(false)
  stockDevuelto    Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cliente     Cliente           @relation(fields: [clienteId], references: [id])
  usuario     User              @relation(fields: [usuarioId], references: [id])
  metodoPago  MetodoPago?       @relation(fields: [metodoPagoId], references: [id])
  detalles    DetallePedido[]
  pagos       Pago[]
  movimientos MovimientoStock[]

  @@index([estado])
  @@index([estadoPago])
  @@index([createdAt])
  @@index([clienteId])
  @@index([usuarioId])
}

model DetallePedido {
  id             String  @id @default(cuid())
  pedidoId       String
  productoId     String
  // Datos congelados al momento de la venta (no depender del producto actual).
  nombreProducto String
  precioUnitario Decimal @db.Decimal(12, 2)
  cantidad       Int
  subtotal       Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
  @@index([productoId])
}

model Pago {
  id           String     @id @default(cuid())
  pedidoId     String
  metodoPagoId String?
  monto        Decimal    @db.Decimal(12, 2)
  estado       EstadoPago @default(PENDIENTE)
  usuarioId    String
  observacion  String?
  createdAt    DateTime   @default(now())

  pedido     Pedido      @relation(fields: [pedidoId], references: [id])
  metodoPago MetodoPago? @relation(fields: [metodoPagoId], references: [id])
  usuario    User        @relation(fields: [usuarioId], references: [id])

  @@index([pedidoId])
  @@index([estado])
}

// ============================================================
// Configuración de envío
// ============================================================

enum TipoCalculoEnvio {
  SIN_CARGO
  TARIFA_FIJA
  POR_PRODUCTO
  POR_BULTO
}

model ConfiguracionEnvio {
  id        String           @id @default(cuid())
  tipo      TipoCalculoEnvio
  precio    Decimal          @default(0) @db.Decimal(12, 2)
  activo    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([activo])
}

// ============================================================
// Auditoría
// ============================================================

model Auditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  accion    String
  entidad   String
  entidadId String?
  datos     Json?
  resultado String?
  createdAt DateTime @default(now())

  usuario User? @relation(fields: [usuarioId], references: [id])

  @@index([createdAt])
  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([accion])
}
